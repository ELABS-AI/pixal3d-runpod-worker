        "output_format": "glb",
        "texture_resolution": 1024
      },
      "timeout": 300000
    },
    {
      "name": "image_to_3d_quality",
      "input": {
        "image_base64": "<base64-encoded-test-image>",
        "detail_level": "high",
        "output_format": "obj",
        "texture_resolution": 2048
      },
      "timeout": 600000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "allowedCudaVersions": [
      "12.8", "12.7", "12.6", "12.5", "12.4", "12.3", "12.2", "12.1", "12.0"
    ]
  }
}
